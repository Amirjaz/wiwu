# Copy to backend/.env. On the server, deploy/remote-deploy.sh creates it on first deploy.
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=example.ir,localhost
# The site's address, used in SMS links. No trailing slash.
PUBLIC_URL=https://example.ir
# Staging: keep search engines out. Set to False on the real domain.
SITE_NOINDEX=True
# Local development only: DEBUG on, insecure fallback key, console SMS, Vite dev server.
# Development=True

# Production: where the Vite build's manifest is (deploy puts the build in /srv/purseshop/www).
# VITE_MANIFEST=/srv/purseshop/www/.vite/manifest.json

# SMS: console (development) or kavenegar. Check the setup with: manage.py sms_check [09xxxxxxxxx]
SMS_BACKEND=kavenegar
KAVENEGAR_API_KEY=
# Which messages use templates approved in the Kavenegar panel instead of plain text: empty for none,
# all, or some, e.g. otp,paid. Templates are named ps-otp, ps-order-created, … (see shop/sms.py);
# override one with SMS_TEMPLATE_<KIND>=name. They need no line and reach numbers that block advertising SMS.
KAVENEGAR_TEMPLATES=all
# The line plain-text SMS go from (empty: the account's default line); only for kinds not in the list above.
KAVENEGAR_SENDER=

# Payments: manual (staff confirm every payment) or cartbecart (automatic, see shop/payments.py).
# Check with: manage.py cartbecart_check [--test 10000]
PAYMENT_PROVIDER=manual
# cartbecart's dashboard → Settings → API key (cb_…).
CARTBECART_API_KEY=
# cartbecart's dashboard → Settings → Webhook → «ساخت کلید امضا». Their webhook address is
# https://<site>/api/payments/cartbecart/
CARTBECART_WEBHOOK_SECRET=
# CARTBECART_API_URL=https://api.cartbecart.com
