[Unit]
Description=Purse store (gunicorn)
After=network.target

[Service]
User=purseshop
Group=purseshop
UMask=0002
WorkingDirectory=/srv/purseshop/app/backend
# 8030: from the shared Nisatech server, where nisatech.org, nisatak.com and contech had 8000-8020. The
# shop has its own server since 2026-10-24 (4 cores; still 3 workers, see HANDOFF -> Next).
ExecStart=/srv/purseshop/app/backend/.venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8030 \
    --timeout 60 \
    --access-logfile - \
    purseshop.wsgi:application
Restart=on-failure

[Install]
WantedBy=multi-user.target
